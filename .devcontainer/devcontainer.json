// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-existing-dockerfile
{
	"name": "Existing Dockerfile",
	"build": {
		// Sets the run context to one level up instead of the .devcontainer folder.
		"context": "..",
		// Update the 'dockerFile' property if you aren't using the standard 'Dockerfile' filename.
		"dockerfile": "../Dockerfile"
	},
	// Runtime arguments for the container
	"runArgs": [
		"--network=host",
		// Mount Podman socket (rootless) as Docker socket for tool compatibility
		"-v", "${localEnv:XDG_RUNTIME_DIR}/podman/podman.sock:/var/run/docker.sock:z"
	],
	// Set the remote user to chris (as defined in Dockerfile)
	"remoteUser": "chris",
	// Install user-space runtimes (Rust, Node/NVM, .NET, PowerShell, Composer) on first start.
	// "postCreateCommand": "bash .devcontainer/postCreate.sh",
	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-dotnettools.csdevkit",
				"anthropic.claude-code",
				"ms-azuretools.vscode-docker",
				"sst-dev.opencode",
				"kickbacksai.kickbacks-ai"
			]
		}
	}
}
